{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://voxelry.duckdns.org/expensetracker",
        "EXPO_PUBLIC_APP_NAME": "ExpenseTracker"
      }
    },
    "preview_local": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://voxelry.duckdns.org/expensetracker/",
        "EXPO_PUBLIC_APP_NAME": "ET-Local"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://voxelry.duckdns.org/expensetracker",
        "EXPO_PUBLIC_APP_NAME": "ExpenseTracker"
      }
    }
  }
}
