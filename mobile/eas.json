{
  "cli": {
    "version": ">= 3.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "API_URL": "https://voxelry.duckdns.org/expensetracker",
        "APP_NAME": "ExpenseTrackerMobile"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "API_URL": "https://voxelry.duckdns.org/expensetracker",
        "APP_NAME": "ExpenseTrackerMobile"
      }
    }
  }
}
